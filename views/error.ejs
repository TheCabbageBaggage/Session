<%- include('partials/head') %>
<%- include('partials/navbar') %>

<main class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-6 text-center">
      <h1 class="display-1 fw-bold text-muted"><%= status %></h1>
      <h4 class="mb-3"><%= message %></h4>
      <% if (stack && process.env.NODE_ENV !== 'production') { %>
        <pre class="text-start bg-light p-3 rounded small overflow-auto" style="max-height:300px"><%= stack %></pre>
      <% } %>
      <a href="/" class="btn btn-primary mt-3">
        <i class="bi bi-house me-1"></i><%= t('common.home') %>
      </a>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
