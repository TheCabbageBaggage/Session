<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> – Session</title>

  <!-- Bootstrap 5 -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" crossorigin="anonymous">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous">
  <!-- App styles -->
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>

<%# ---- Navbar ---- %>
<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
  <div class="container-fluid">
    <a class="navbar-brand fw-bold" href="/">
      <i class="bi bi-calendar2-check me-2"></i>Session
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="mainNav">
      <% if (user) { %>
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
          <li class="nav-item">
            <a class="nav-link" href="/bookings">
              <i class="bi bi-calendar3 me-1"></i><%= t('nav.bookings') %>
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/bookings/new">
              <i class="bi bi-plus-circle me-1"></i><%= t('nav.newBooking') %>
            </a>
          </li>
          <% if (isAdmin) { %>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
              <i class="bi bi-gear me-1"></i><%= t('nav.admin') %>
            </a>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item" href="/admin"><%= t('admin.dashboard') %></a></li>
              <li><a class="dropdown-item" href="/admin/rooms"><%= t('admin.rooms') %></a></li>
              <li><a class="dropdown-item" href="/admin/users"><%= t('admin.users') %></a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item" href="/admin/logs"><%= t('admin.logs') %></a></li>
            </ul>
          </li>
          <% } %>
        </ul>

        <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-center">
          <li class="nav-item">
            <a class="nav-link" href="/public/rooms" target="_blank">
              <i class="bi bi-tv me-1"></i><%= t('nav.publicView') %>
            </a>
          </li>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
              <i class="bi bi-person-circle me-1"></i>
              <%= user.firstName %> <%= user.lastName %>
            </a>
            <ul class="dropdown-menu dropdown-menu-end">
              <li><a class="dropdown-item" href="/profile"><%= t('nav.profile') %></a></li>
              <li><hr class="dropdown-divider"></li>
              <li>
                <form action="/logout" method="POST" class="d-inline">
                  <button type="submit" class="dropdown-item text-danger">
                    <i class="bi bi-box-arrow-right me-1"></i><%= t('auth.logout') %>
                  </button>
                </form>
              </li>
            </ul>
          </li>
        </ul>
      <% } %>
    </div>
  </div>
</nav>

<%# ---- Main content ---- %>
<main class="container-fluid py-4">
  <%- body %>
</main>

<%# ---- Footer ---- %>
<footer class="footer mt-auto py-3 bg-light border-top">
  <div class="container-fluid">
    <span class="text-muted small">
      &copy; <%= new Date().getFullYear() %> Session &ndash; Room Booking System
    </span>
    <span class="text-muted small float-end">
      <a href="/public/rooms" class="text-muted" target="_blank">
        <i class="bi bi-tv me-1"></i><%= t('nav.publicView') %>
      </a>
    </span>
  </div>
</footer>

<!-- Bootstrap 5 JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
<script src="/js/app.js"></script>
</body>
</html>
