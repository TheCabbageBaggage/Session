<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> – Session</title>
  <meta http-equiv="refresh" content="<%= refreshInterval || 60 %>">

  <!-- Bootstrap 5 -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" crossorigin="anonymous">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous">
  <!-- App styles -->
  <link rel="stylesheet" href="/css/app.css">
  <link rel="stylesheet" href="/css/public.css">
</head>
<body class="public-view">

<header class="public-header bg-primary text-white py-2 px-3 d-flex align-items-center justify-content-between">
  <div class="d-flex align-items-center">
    <i class="bi bi-calendar2-check fs-4 me-2"></i>
    <span class="fw-bold fs-5">Session</span>
    <span class="ms-3 text-white-50">Room Overview</span>
  </div>
  <div class="text-end">
    <span id="current-date" class="fw-semibold"><%= date %></span>
    <span class="ms-3" id="current-time"></span>
  </div>
</header>

<main class="public-main">
  <%- body %>
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
<script src="/js/public.js"></script>
</body>
</html>
