<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<main class="container py-4">
  <div class="row mb-4">
    <div class="col">
      <h2><i class="bi bi-person-circle me-2"></i><%= t('nav.profile') %></h2>
    </div>
  </div>

  <div class="row g-4">
    <!-- Profile settings -->
    <div class="col-lg-7">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom">
          <h5 class="mb-0"><%= t('profile.heading') %></h5>
        </div>
        <div class="card-body">

          <% if (error) { %>
            <div class="alert alert-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %></div>
          <% } %>
          <% if (success) { %>
            <div class="alert alert-success alert-dismissible fade show">
              <i class="bi bi-check-circle-fill me-2"></i><%= success %>
              <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
          <% } %>

          <form action="/profile" method="POST" novalidate>

            <div class="mb-3">
              <label for="company" class="form-label"><%= t('profile.company') %></label>
              <input
                type="text"
                class="form-control"
                id="company"
                name="company"
                value="<%= user.profile?.company || '' %>"
                maxlength="200"
              >
              <div class="form-text"><%= t('profile.companyHint') %></div>
            </div>

            <div class="mb-3">
              <label for="costCentre" class="form-label"><%= t('profile.costCentre') %></label>
              <input
                type="text"
                class="form-control"
                id="costCentre"
                name="costCentre"
                value="<%= user.profile?.costCentre || '' %>"
                maxlength="100"
              >
              <div class="form-text"><%= t('profile.costCentreHint') %></div>
            </div>

            <div class="mb-4">
              <label for="language" class="form-label"><%= t('profile.language') %></label>
              <select class="form-select" id="language" name="language">
                <option value="en" <%= (user.profile?.language || 'en') === 'en' ? 'selected' : '' %>>
                  🇬🇧 English
                </option>
                <option value="de" <%= user.profile?.language === 'de' ? 'selected' : '' %>>
                  🇩🇪 Deutsch
                </option>
              </select>
            </div>

            <button type="submit" class="btn btn-primary">
              <i class="bi bi-check-lg me-1"></i><%= t('common.save') %>
            </button>

          </form>
        </div>
      </div>
    </div>

    <!-- Account info sidebar -->
    <div class="col-lg-5">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom">
          <h6 class="mb-0"><%= t('profile.accountInfo') %></h6>
        </div>
        <div class="card-body">
          <dl class="mb-0">
            <dt class="small text-muted"><%= t('admin.username') %></dt>
            <dd><code><%= user.username %></code></dd>

            <dt class="small text-muted"><%= t('admin.name') %></dt>
            <dd><%= user.firstName %> <%= user.lastName %></dd>

            <dt class="small text-muted"><%= t('admin.email') %></dt>
            <dd class="small"><%= user.email %></dd>

            <dt class="small text-muted"><%= t('admin.role') %></dt>
            <dd>
              <% user.roles.forEach(ur => { %>
                <span class="badge <%= ur.role.name === 'Administrator' ? 'bg-danger' : 'bg-secondary' %>">
                  <%= ur.role.name %>
                </span>
              <% }) %>
            </dd>

            <dt class="small text-muted"><%= t('admin.type') %></dt>
            <dd>
              <span class="badge <%= user.isLocal ? 'bg-info text-dark' : 'bg-light text-dark border' %>">
                <%= user.isLocal ? t('admin.localAccount') : t('admin.adAccount') %>
              </span>
            </dd>
          </dl>

          <% if (user.isLocal) { %>
            <hr>
            <a href="/change-password" class="btn btn-outline-secondary btn-sm w-100">
              <i class="bi bi-key me-1"></i><%= t('auth.changePassword') %>
            </a>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
