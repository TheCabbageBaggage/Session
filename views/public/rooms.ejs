<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Room Overview – Today – Session</title>
  <meta http-equiv="refresh" content="<%= refreshInterval || 60 %>">

  <!-- Bootstrap 5 -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" crossorigin="anonymous">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous">
  <!-- App styles -->
  <link rel="stylesheet" href="/css/app.css">
  <link rel="stylesheet" href="/css/public.css">
</head>
<body class="public-view bg-light">

<header class="public-header bg-primary text-white py-2 px-3 d-flex align-items-center justify-content-between">
  <div class="d-flex align-items-center">
    <i class="bi bi-calendar2-check fs-4 me-2"></i>
    <span class="fw-bold fs-5">Session</span>
    <span class="ms-3 text-white-50 fs-6">Room Overview</span>
  </div>
  <div class="text-end">
    <span class="fw-semibold me-3"><%= date %></span>
    <span id="current-time" class="fw-semibold"></span>
  </div>
</header>

<div class="public-timeline-wrapper p-3">
  <% if (rooms.length === 0) { %>
    <div class="text-center text-muted py-5">
      <i class="bi bi-door-closed fs-1 d-block mb-2"></i>
      <p class="mb-0">No rooms configured yet.</p>
      <p class="small">Room management is available in M3.</p>
    </div>
  <% } else { %>
    <div class="public-rooms-grid d-flex gap-3">
      <% rooms.forEach(room => { %>
        <div class="public-room-column card border-0 shadow-sm" style="min-width:200px; flex:1">
          <div class="card-header bg-white border-bottom text-center py-2">
            <strong class="d-block"><%= room.name %></strong>
            <small class="text-muted">
              <i class="bi bi-people me-1"></i><%= room.capacity %>
              <% if (room.location) { %>
                &bull; <%= room.location %>
              <% } %>
            </small>
          </div>
          <div class="card-body p-2 public-room-slots">
            <!-- Booking blocks rendered here by M3 -->
            <div class="text-center text-muted py-3 small">No bookings today</div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<div id="time-indicator" class="position-fixed w-100" style="pointer-events:none; z-index:10"></div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
<script src="/js/public.js"></script>
</body>
</html>
