<%- include('partials/head') %>
<%- include('partials/navbar') %>

<main class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col">
      <h2><i class="bi bi-speedometer2 me-2"></i><%= t('nav.dashboard') %></h2>
      <p class="text-muted"><%= t('dashboard.subtitle') %></p>
    </div>
    <div class="col-auto">
      <a href="/bookings/new" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i><%= t('nav.newBooking') %>
      </a>
    </div>
  </div>

  <!-- Quick stats row (populated in M5) -->
  <div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body d-flex align-items-center">
          <div class="flex-shrink-0 bg-primary bg-opacity-10 rounded p-3 me-3">
            <i class="bi bi-calendar-check text-primary fs-4"></i>
          </div>
          <div>
            <div class="fw-semibold fs-5">–</div>
            <div class="text-muted small"><%= t('dashboard.todayBookings') %></div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body d-flex align-items-center">
          <div class="flex-shrink-0 bg-success bg-opacity-10 rounded p-3 me-3">
            <i class="bi bi-door-open text-success fs-4"></i>
          </div>
          <div>
            <div class="fw-semibold fs-5">–</div>
            <div class="text-muted small"><%= t('dashboard.availableRooms') %></div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body d-flex align-items-center">
          <div class="flex-shrink-0 bg-warning bg-opacity-10 rounded p-3 me-3">
            <i class="bi bi-people text-warning fs-4"></i>
          </div>
          <div>
            <div class="fw-semibold fs-5">–</div>
            <div class="text-muted small"><%= t('dashboard.myUpcoming') %></div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body d-flex align-items-center">
          <div class="flex-shrink-0 bg-info bg-opacity-10 rounded p-3 me-3">
            <i class="bi bi-graph-up text-info fs-4"></i>
          </div>
          <div>
            <div class="fw-semibold fs-5">–</div>
            <div class="text-muted small"><%= t('dashboard.monthUtilisation') %></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Booking calendar placeholder -->
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-bottom d-flex align-items-center justify-content-between">
      <h5 class="mb-0"><%= t('bookings.calendar') %></h5>
      <a href="/bookings" class="btn btn-sm btn-outline-primary"><%= t('bookings.viewAll') %></a>
    </div>
    <div class="card-body text-center py-5 text-muted">
      <i class="bi bi-calendar3 fs-1 d-block mb-2"></i>
      <p class="mb-0"><%= t('dashboard.calendarComingSoon') %></p>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
