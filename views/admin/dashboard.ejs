<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<main class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col">
      <h2><i class="bi bi-speedometer2 me-2"></i><%= t('admin.dashboard') %></h2>
      <p class="text-muted"><%= t('admin.dashboardSubtitle') %></p>
    </div>
  </div>

  <div class="row g-3">
    <div class="col-md-6 col-xl-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <h6 class="text-muted text-uppercase small mb-1"><%= t('admin.rooms') %></h6>
          <div class="d-flex align-items-center justify-content-between">
            <span class="fs-3 fw-bold">–</span>
            <a href="/admin/rooms" class="btn btn-sm btn-outline-primary">
              <i class="bi bi-arrow-right"></i>
            </a>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-6 col-xl-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <h6 class="text-muted text-uppercase small mb-1"><%= t('admin.users') %></h6>
          <div class="d-flex align-items-center justify-content-between">
            <span class="fs-3 fw-bold">–</span>
            <a href="/admin/users" class="btn btn-sm btn-outline-primary">
              <i class="bi bi-arrow-right"></i>
            </a>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-6 col-xl-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <h6 class="text-muted text-uppercase small mb-1"><%= t('dashboard.todayBookings') %></h6>
          <div class="d-flex align-items-center justify-content-between">
            <span class="fs-3 fw-bold">–</span>
            <a href="/bookings" class="btn btn-sm btn-outline-primary">
              <i class="bi bi-arrow-right"></i>
            </a>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-6 col-xl-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <h6 class="text-muted text-uppercase small mb-1"><%= t('admin.exchangeSync') %></h6>
          <div class="d-flex align-items-center">
            <span class="badge bg-secondary">–</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-3 mt-2">
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom">
          <h5 class="mb-0"><%= t('admin.logs') %></h5>
        </div>
        <div class="card-body text-center py-4 text-muted">
          <i class="bi bi-journal-text fs-1 d-block mb-2"></i>
          <p class="mb-0"><%= t('admin.logsComingSoon') %></p>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
