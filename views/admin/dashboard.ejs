<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<main class="container-fluid py-4">

  <%# ---- Default-password warning banner ---- %>
  <% if (defaultPwdCount > 0) { %>
    <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
      <i class="bi bi-shield-exclamation me-3 fs-4 flex-shrink-0"></i>
      <div>
        <strong><%= t('admin.defaultPasswordWarningTitle') %></strong>
        <%= t('admin.defaultPasswordWarningBody', { count: defaultPwdCount }) %>
        <a href="/admin/users?roleId=&search=" class="alert-link ms-2">
          <%= t('admin.viewUsers') %> &rarr;
        </a>
      </div>
    </div>
  <% } %>

  <div class="row mb-4">
    <div class="col">
      <h2><i class="bi bi-speedometer2 me-2"></i><%= t('admin.dashboard') %></h2>
      <p class="text-muted"><%= t('admin.dashboardSubtitle') %></p>
    </div>
  </div>

  <!-- KPI Cards -->
  <div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body d-flex align-items-center">
          <div class="flex-shrink-0 bg-primary bg-opacity-10 rounded p-3 me-3">
            <i class="bi bi-people text-primary fs-4"></i>
          </div>
          <div>
            <div class="fw-bold fs-4"><%= totalUsers %></div>
            <div class="text-muted small"><%= t('admin.activeUsers') %></div>
          </div>
          <a href="/admin/users" class="stretched-link"></a>
        </div>
      </div>
    </div>

    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body d-flex align-items-center">
          <div class="flex-shrink-0 bg-success bg-opacity-10 rounded p-3 me-3">
            <i class="bi bi-door-open text-success fs-4"></i>
          </div>
          <div>
            <div class="fw-bold fs-4"><%= totalRooms %></div>
            <div class="text-muted small"><%= t('admin.activeRooms') %></div>
          </div>
          <a href="/admin/rooms" class="stretched-link"></a>
        </div>
      </div>
    </div>

    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body d-flex align-items-center">
          <div class="flex-shrink-0 bg-warning bg-opacity-10 rounded p-3 me-3">
            <i class="bi bi-calendar-check text-warning fs-4"></i>
          </div>
          <div>
            <div class="fw-bold fs-4"><%= todayBookings %></div>
            <div class="text-muted small"><%= t('admin.todayBookings') %></div>
          </div>
          <a href="/bookings" class="stretched-link"></a>
        </div>
      </div>
    </div>

    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body d-flex align-items-center">
          <div class="flex-shrink-0 <%= recentSync && recentSync.success ? 'bg-success' : 'bg-secondary' %> bg-opacity-10 rounded p-3 me-3">
            <i class="bi bi-arrow-repeat <%= recentSync && recentSync.success ? 'text-success' : 'text-secondary' %> fs-4"></i>
          </div>
          <div>
            <div class="fw-semibold small">
              <% if (recentSync) { %>
                <span class="badge <%= recentSync.success ? 'bg-success' : 'bg-danger' %>">
                  <%= recentSync.success ? t('admin.syncOk') : t('admin.syncFailed') %>
                </span>
              <% } else { %>
                <span class="badge bg-secondary"><%= t('admin.syncNever') %></span>
              <% } %>
            </div>
            <div class="text-muted small"><%= t('admin.exchangeSync') %></div>
          </div>
          <a href="/admin/logs/ad" class="stretched-link"></a>
        </div>
      </div>
    </div>
  </div>

  <!-- M5 KPI Cards -->
  <div class="row g-3 mb-4">
    <!-- Room Utilisation -->
    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="d-flex align-items-center mb-2">
            <div class="flex-shrink-0 bg-info bg-opacity-10 rounded p-2 me-2">
              <i class="bi bi-pie-chart text-info"></i>
            </div>
            <span class="text-muted small"><%= t('admin.dashCurrentUtilisation') %></span>
          </div>
          <div class="d-flex align-items-end gap-2">
            <span class="fw-bold fs-4"><%= dashKpis.utilisationPct %>%</span>
            <span class="text-muted small mb-1"><%= dashKpis.occupiedRooms %>/<%= dashKpis.totalActiveRooms %> rooms</span>
          </div>
          <div class="progress mt-2" style="height:6px">
            <div class="progress-bar bg-info" style="width:<%= dashKpis.utilisationPct %>%"></div>
          </div>
          <a href="/admin/reports/utilisation" class="stretched-link"></a>
        </div>
      </div>
    </div>

    <!-- Exchange Sync Status -->
    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="d-flex align-items-center mb-2">
            <div class="flex-shrink-0 <%= dashKpis.exchangeFailedCount > 0 ? 'bg-danger' : 'bg-success' %> bg-opacity-10 rounded p-2 me-2">
              <i class="bi bi-cloud-arrow-up <%= dashKpis.exchangeFailedCount > 0 ? 'text-danger' : 'text-success' %>"></i>
            </div>
            <span class="text-muted small"><%= t('admin.dashExchangeSync') %></span>
          </div>
          <% if (dashKpis.exchangeFailedCount > 0) { %>
            <span class="badge bg-danger fs-6"><%= dashKpis.exchangeFailedCount %> failed</span>
          <% } else { %>
            <span class="badge bg-success">OK</span>
          <% } %>
          <a href="/admin/logs/exchange" class="stretched-link"></a>
        </div>
      </div>
    </div>

    <!-- Top Rooms this month -->
    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-white border-bottom py-2">
          <span class="small fw-semibold"><i class="bi bi-trophy me-1 text-warning"></i><%= t('admin.dashTopRooms') %></span>
        </div>
        <div class="card-body py-2 px-3">
          <% if (dashKpis.topRooms.length === 0) { %>
            <span class="text-muted small">No bookings yet</span>
          <% } else { %>
            <% dashKpis.topRooms.slice(0, 3).forEach((r, i) => { %>
              <div class="d-flex justify-content-between small py-1 border-bottom">
                <span class="text-truncate me-2"><%= i+1 %>. <%= r.roomName %></span>
                <span class="fw-semibold text-nowrap"><%= r.count %> <%= t('admin.dashBookings') %></span>
              </div>
            <% }) %>
          <% } %>
          <a href="/admin/reports/rooms" class="stretched-link"></a>
        </div>
      </div>
    </div>

    <!-- Top Cost Centres this month -->
    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-white border-bottom py-2">
          <span class="small fw-semibold"><i class="bi bi-cash-coin me-1 text-primary"></i><%= t('admin.dashTopCostCentres') %></span>
        </div>
        <div class="card-body py-2 px-3">
          <% if (dashKpis.topCostCentres.length === 0) { %>
            <span class="text-muted small">No bookings yet</span>
          <% } else { %>
            <% dashKpis.topCostCentres.slice(0, 3).forEach((c, i) => { %>
              <div class="d-flex justify-content-between small py-1 border-bottom">
                <span class="text-truncate me-2"><%= i+1 %>. <%= c.costCentre %></span>
                <span class="fw-semibold text-nowrap"><%= c.count %> <%= t('admin.dashBookings') %></span>
              </div>
            <% }) %>
          <% } %>
          <a href="/admin/reports/cost-centre" class="stretched-link"></a>
        </div>
      </div>
    </div>
  </div>

  <!-- Catering summary this month -->
  <% if (dashKpis.cateringSummary.length > 0) { %>
  <div class="row g-3 mb-4">
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom">
          <h6 class="mb-0"><i class="bi bi-cup-hot me-1"></i><%= t('admin.dashCateringSummary') %></h6>
        </div>
        <div class="card-body">
          <div class="row g-3">
            <% dashKpis.cateringSummary.forEach(c => { %>
              <div class="col-auto">
                <div class="border rounded px-3 py-2 text-center">
                  <div class="fw-bold fs-5"><%= c.quantity %></div>
                  <div class="text-muted small"><%= c.option.replace(/_/g, ' ') %></div>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      </div>
    </div>
  </div>
  <% } %>

  <!-- Quick links -->
  <div class="row g-3">
    <div class="col-md-6 col-xl-3">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
          <h6 class="mb-0"><%= t('admin.rooms') %></h6>
          <a href="/admin/rooms" class="btn btn-sm btn-outline-primary"><%= t('common.viewAll') %></a>
        </div>
        <div class="card-body py-3">
          <div class="d-flex gap-2">
            <a href="/admin/rooms/new" class="btn btn-outline-secondary btn-sm">
              <i class="bi bi-plus-circle me-1"></i><%= t('admin.addRoom') %>
            </a>
            <a href="/admin/companies" class="btn btn-outline-secondary btn-sm">
              <i class="bi bi-building me-1"></i><%= t('admin.companies') %>
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-6 col-xl-3">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
          <h6 class="mb-0"><%= t('bookings.calendar') %></h6>
          <a href="/bookings" class="btn btn-sm btn-outline-primary"><%= t('common.viewAll') %></a>
        </div>
        <div class="card-body py-3">
          <div class="d-flex gap-2">
            <a href="/bookings/new" class="btn btn-outline-secondary btn-sm">
              <i class="bi bi-plus-circle me-1"></i><%= t('bookings.newBooking') %>
            </a>
            <a href="/public/rooms" class="btn btn-outline-secondary btn-sm" target="_blank">
              <i class="bi bi-display me-1"></i>Public View
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
          <h6 class="mb-0"><%= t('admin.users') %></h6>
          <a href="/admin/users" class="btn btn-sm btn-outline-primary"><%= t('common.viewAll') %></a>
        </div>
        <div class="card-body py-3">
          <div class="d-flex gap-2">
            <a href="/admin/users" class="btn btn-outline-secondary btn-sm">
              <i class="bi bi-people me-1"></i><%= t('admin.manageUsers') %>
            </a>
            <form action="/admin/sync/ad" method="POST" class="d-inline">
              <button type="submit" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-arrow-repeat me-1"></i><%= t('admin.runAdSync') %>
              </button>
            </form>
          </div>
          <% if (recentSync) { %>
            <p class="text-muted small mt-2 mb-0">
              <%= t('admin.lastSync') %>:
              <%= recentSync.startedAt.toLocaleString() %>
              &bull; +<%= recentSync.usersAdded %> / ~<%= recentSync.usersUpdated %> / –<%= recentSync.usersDeactivated %>
            </p>
          <% } %>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
          <h6 class="mb-0"><%= t('admin.logs') %></h6>
          <a href="/admin/logs/audit" class="btn btn-sm btn-outline-primary"><%= t('common.viewAll') %></a>
        </div>
        <div class="card-body py-3">
          <div class="d-flex gap-2 flex-wrap">
            <a href="/admin/logs/audit" class="btn btn-outline-secondary btn-sm">
              <i class="bi bi-journal-text me-1"></i><%= t('admin.auditLog') %>
            </a>
            <a href="/admin/logs/ad" class="btn btn-outline-secondary btn-sm">
              <i class="bi bi-people-fill me-1"></i><%= t('admin.adSyncLog') %>
            </a>
            <a href="/admin/logs/email" class="btn btn-outline-secondary btn-sm">
              <i class="bi bi-envelope me-1"></i><%= t('admin.emailLog') %>
            </a>
            <a href="/admin/logs/exchange" class="btn btn-outline-secondary btn-sm">
              <i class="bi bi-cloud-arrow-up me-1"></i><%= t('admin.exchangeSyncLog') %>
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-6 col-xl-3">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
          <h6 class="mb-0"><%= t('admin.reports') %></h6>
          <a href="/admin/reports" class="btn btn-sm btn-outline-primary"><%= t('common.viewAll') %></a>
        </div>
        <div class="card-body py-3">
          <div class="d-flex gap-2 flex-wrap">
            <a href="/admin/reports/cost-centre" class="btn btn-outline-secondary btn-sm">
              <i class="bi bi-cash-coin me-1"></i><%= t('admin.reportCostCentre') %>
            </a>
            <a href="/admin/reports/utilisation" class="btn btn-outline-secondary btn-sm">
              <i class="bi bi-pie-chart me-1"></i><%= t('admin.reportUtilisation') %>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

</main>

<%- include('../partials/footer') %>
