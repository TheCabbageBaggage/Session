<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<main class="container-fluid py-4">
  <div class="row mb-4 align-items-center">
    <div class="col">
      <h2><i class="bi bi-people me-2"></i><%= t('admin.users') %></h2>
    </div>
    <div class="col-auto">
      <form action="/admin/sync/ad" method="POST" class="d-inline">
        <button type="submit" class="btn btn-outline-primary btn-sm">
          <i class="bi bi-arrow-repeat me-1"></i><%= t('admin.runAdSync') %>
        </button>
      </form>
    </div>
  </div>

  <!-- Search & filter -->
  <form class="row g-2 mb-4" method="GET" action="/admin/users">
    <div class="col-sm-6 col-md-5">
      <div class="input-group">
        <span class="input-group-text"><i class="bi bi-search"></i></span>
        <input
          type="text"
          class="form-control"
          name="search"
          value="<%= search %>"
          placeholder="<%= t('admin.searchUsers') %>"
        >
      </div>
    </div>
    <div class="col-sm-4 col-md-3">
      <select class="form-select" name="roleId">
        <option value=""><%= t('admin.allRoles') %></option>
        <% roles.forEach(r => { %>
          <option value="<%= r.id %>" <%= selectedRoleId == r.id ? 'selected' : '' %>>
            <%= r.name %>
          </option>
        <% }) %>
      </select>
    </div>
    <div class="col-auto">
      <button type="submit" class="btn btn-primary"><%= t('common.filter') %></button>
      <a href="/admin/users" class="btn btn-outline-secondary ms-1"><%= t('common.reset') %></a>
    </div>
  </form>

  <!-- Users table -->
  <div class="card border-0 shadow-sm">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th><%= t('admin.username') %></th>
              <th><%= t('admin.name') %></th>
              <th><%= t('admin.email') %></th>
              <th><%= t('admin.role') %></th>
              <th><%= t('admin.type') %></th>
              <th><%= t('admin.status') %></th>
              <th><%= t('admin.lastLogin') %></th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% if (users.length === 0) { %>
              <tr>
                <td colspan="8" class="text-center text-muted py-4">
                  <%= t('admin.noUsersFound') %>
                </td>
              </tr>
            <% } %>
            <% users.forEach(u => { %>
              <tr class="<%= !u.isActive ? 'table-secondary text-muted' : '' %>">
                <td>
                  <code class="text-dark"><%= u.username %></code>
                  <% if (u.isProtected) { %>
                    <span class="badge bg-dark ms-1" title="<%= t('admin.protectedAccount') %>">
                      <i class="bi bi-shield-fill"></i>
                    </span>
                  <% } %>
                  <% if (u.mustChangePwd) { %>
                    <span class="badge bg-warning text-dark ms-1" title="<%= t('admin.mustChangePwd') %>">
                      <i class="bi bi-key"></i>
                    </span>
                  <% } %>
                </td>
                <td><%= u.firstName %> <%= u.lastName %></td>
                <td class="small"><%= u.email %></td>
                <td>
                  <% u.roles.forEach(ur => { %>
                    <span class="badge <%= ur.role.name === 'Administrator' ? 'bg-danger' : 'bg-secondary' %>">
                      <%= ur.role.name %>
                    </span>
                  <% }) %>
                </td>
                <td>
                  <span class="badge <%= u.isLocal ? 'bg-info text-dark' : 'bg-light text-dark border' %>">
                    <%= u.isLocal ? t('admin.localAccount') : t('admin.adAccount') %>
                  </span>
                </td>
                <td>
                  <% if (u.isActive) { %>
                    <span class="badge bg-success"><%= t('common.active') %></span>
                  <% } else { %>
                    <span class="badge bg-secondary"><%= t('common.inactive') %></span>
                  <% } %>
                </td>
                <td class="small text-muted">
                  <%= u.lastLogin ? u.lastLogin.toLocaleDateString() : '–' %>
                </td>
                <td class="text-end">
                  <a href="/admin/users/<%= u.id %>/edit" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-pencil"></i>
                  </a>
                  <% if (u.isActive && !u.isProtected) { %>
                    <form action="/admin/users/<%= u.id %>/deactivate" method="POST" class="d-inline"
                      onsubmit="return confirm('<%= t('admin.confirmDeactivate') %>')">
                      <button type="submit" class="btn btn-sm btn-outline-danger" title="<%= t('admin.deactivate') %>">
                        <i class="bi bi-person-x"></i>
                      </button>
                    </form>
                  <% } else if (!u.isActive) { %>
                    <form action="/admin/users/<%= u.id %>/activate" method="POST" class="d-inline">
                      <button type="submit" class="btn btn-sm btn-outline-success" title="<%= t('admin.activate') %>">
                        <i class="bi bi-person-check"></i>
                      </button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
      <div class="card-footer bg-white d-flex justify-content-between align-items-center">
        <span class="text-muted small">
          <%= t('common.showing') %> <%= (page-1)*pageSize + 1 %>–<%= Math.min(page*pageSize, total) %>
          <%= t('common.of') %> <%= total %>
        </span>
        <nav>
          <ul class="pagination pagination-sm mb-0">
            <% for (let p = 1; p <= totalPages; p++) { %>
              <li class="page-item <%= p === page ? 'active' : '' %>">
                <a class="page-link" href="?page=<%= p %>&search=<%= search %>&roleId=<%= selectedRoleId %>">
                  <%= p %>
                </a>
              </li>
            <% } %>
          </ul>
        </nav>
      </div>
    <% } %>
  </div>

</main>

<%- include('../partials/footer') %>
