<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<main class="container py-4">
  <div class="row mb-3 align-items-center">
    <div class="col">
      <h2 class="mb-0">
        <i class="bi bi-<%= booking ? 'pencil' : 'plus-circle' %> me-2"></i><%= title %>
      </h2>
    </div>
    <div class="col-auto">
      <a href="<%= booking ? '/bookings/' + booking.id : '/bookings' %>" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i><%= t('common.back') %>
      </a>
    </div>
  </div>

  <% if (error) { %>
    <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-1"></i><%= error %></div>
  <% } %>

  <form method="POST" action="<%= booking ? '/bookings/' + booking.id + '/edit' : '/bookings' %>">
    <div class="row g-4">

      <!-- Main fields -->
      <div class="col-lg-8">

        <!-- Date & Time -->
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-header bg-white border-bottom">
            <strong><i class="bi bi-clock me-1"></i><%= t('bookings.dateTime') %></strong>
          </div>
          <div class="card-body">
            <div class="row g-3">
              <div class="col-md-4">
                <label class="form-label fw-semibold" for="date"><%= t('bookings.date') %> <span class="text-danger">*</span></label>
                <input type="date" id="date" name="date" class="form-control"
                       value="<%= prefill.date || '' %>" required
                       min="<%= new Date().toISOString().slice(0,10) %>">
              </div>
              <div class="col-md-4">
                <label class="form-label fw-semibold" for="startTime"><%= t('bookings.startTime') %> <span class="text-danger">*</span></label>
                <input type="time" id="startTime" name="startTime" class="form-control"
                       value="<%= prefill.startTime || '09:00' %>" required step="900">
              </div>
              <div class="col-md-4">
                <label class="form-label fw-semibold" for="endTime"><%= t('bookings.endTime') %> <span class="text-danger">*</span></label>
                <input type="time" id="endTime" name="endTime" class="form-control"
                       value="<%= prefill.endTime || '10:00' %>" required step="900">
              </div>
            </div>
          </div>
        </div>

        <!-- Room selection -->
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-header bg-white border-bottom d-flex align-items-center justify-content-between">
            <strong><i class="bi bi-door-open me-1"></i><%= t('bookings.selectRoom') %></strong>
            <button type="button" class="btn btn-sm btn-outline-primary" id="checkAvailabilityBtn">
              <i class="bi bi-search me-1"></i><%= t('bookings.checkAvailability') %>
            </button>
          </div>
          <div class="card-body">
            <div id="availabilityHint" class="text-muted small mb-3">
              <%= t('bookings.availabilityHint') %>
            </div>
            <div id="roomList">
              <% if (rooms.length === 0) { %>
                <p class="text-muted"><%= t('admin.noRoomsYet') %></p>
              <% } else { %>
                <div class="row g-2">
                  <% rooms.forEach(room => { %>
                    <div class="col-md-6">
                      <div class="room-card border rounded p-3 h-100 <%= (prefill.roomId && Number(prefill.roomId) === room.id) ? 'border-primary' : '' %>"
                           style="cursor:pointer;" onclick="selectRoom(<%= room.id %>)">
                        <div class="d-flex align-items-start">
                          <input type="radio" name="roomId" value="<%= room.id %>"
                                 id="room_<%= room.id %>" class="form-check-input mt-1 me-2"
                                 <%= (prefill.roomId && Number(prefill.roomId) === room.id) ? 'checked' : '' %> required>
                          <label for="room_<%= room.id %>" class="flex-grow-1" style="cursor:pointer;">
                            <strong class="d-block"><%= room.name %></strong>
                            <small class="text-muted">
                              <i class="bi bi-people me-1"></i><%= room.capacity %>
                              <% if (room.location) { %>&bull; <%= room.location %><% } %>
                              <% if (room.type === 'HALL') { %>
                                &bull; <span class="badge bg-warning-subtle text-warning">Hall</span>
                              <% } %>
                            </small>
                            <% if (room.cateringOptions && room.cateringOptions.length > 0) { %>
                              <br><small class="text-muted">
                                <i class="bi bi-cup-hot me-1"></i><%= room.cateringOptions.slice(0,3).map(c => c.cateringOption).join(', ') %>
                              </small>
                            <% } %>
                          </label>
                        </div>
                      </div>
                    </div>
                  <% }) %>
                </div>
              <% } %>
            </div>
          </div>
        </div>

        <!-- Details -->
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-header bg-white border-bottom">
            <strong><i class="bi bi-card-text me-1"></i><%= t('bookings.details') %></strong>
          </div>
          <div class="card-body">
            <div class="mb-3">
              <label class="form-label fw-semibold" for="title"><%= t('bookings.bookingTitle') %></label>
              <input type="text" id="title" name="title" class="form-control"
                     value="<%= booking ? (booking.title || '') : '' %>" maxlength="200"
                     placeholder="<%= t('bookings.titlePlaceholder') %>">
            </div>
            <div class="row g-3">
              <div class="col-md-4">
                <label class="form-label fw-semibold" for="attendeeCount"><%= t('bookings.attendees') %> <span class="text-danger">*</span></label>
                <input type="number" id="attendeeCount" name="attendeeCount" class="form-control"
                       value="<%= booking ? booking.attendeeCount : 1 %>" min="1" max="9999" required>
              </div>
              <div class="col-md-4">
                <label class="form-label fw-semibold" for="company"><%= t('profile.company') %> <span class="text-danger">*</span></label>
                <% if (companies && companies.length > 0) { %>
                  <select id="company" name="company" class="form-select" required>
                    <% companies.filter(c => c.isActive).forEach(c => { %>
                      <% const selected = booking ? (booking.company === c.name) : (profile && profile.company === c.name) || c.isDefault; %>
                      <option value="<%= c.name %>" <%= selected ? 'selected' : '' %>><%= c.name %></option>
                    <% }) %>
                  </select>
                <% } else { %>
                  <input type="text" id="company" name="company" class="form-control"
                         value="<%= booking ? (booking.company || '') : (profile ? (profile.company || '') : '') %>"
                         required maxlength="100">
                <% } %>
              </div>
              <div class="col-md-4">
                <label class="form-label fw-semibold" for="costCentre"><%= t('profile.costCentre') %> <span class="text-danger">*</span></label>
                <input type="text" id="costCentre" name="costCentre" class="form-control"
                       value="<%= booking ? (booking.costCentre || '') : (profile ? (profile.costCentre || '') : '') %>"
                       required maxlength="50"
                       placeholder="e.g. IT-001">
              </div>
            </div>
            <div class="mt-3">
              <label class="form-label fw-semibold" for="notes"><%= t('bookings.notes') %></label>
              <textarea id="notes" name="notes" class="form-control" rows="3"
                        maxlength="1000"><%= booking ? (booking.notes || '') : '' %></textarea>
            </div>
          </div>
        </div>

        <!-- Seating layout (shown for halls) -->
        <% if (layouts && layouts.length > 0) { %>
          <div class="card border-0 shadow-sm mb-4" id="seatingCard" style="display:none!important;">
            <div class="card-header bg-white border-bottom">
              <strong><i class="bi bi-grid-3x3 me-1"></i><%= t('bookings.seatingLayout') %></strong>
            </div>
            <div class="card-body">
              <select name="seatingLayoutId" class="form-select">
                <option value=""><%= t('bookings.noLayout') %></option>
                <% layouts.forEach(layout => { %>
                  <option value="<%= layout.id %>"
                          <%= (booking && booking.seatingLayoutId === layout.id) ? 'selected' : '' %>>
                    <%= layout.name %>
                  </option>
                <% }) %>
              </select>
            </div>
          </div>
        <% } %>

      </div>

      <!-- Right column: attendees, catering, actions -->
      <div class="col-lg-4">

        <div class="card border-0 shadow-sm mb-4">
          <div class="card-header bg-white border-bottom">
            <strong><i class="bi bi-envelope me-1"></i><%= t('bookings.attendeeEmails') %></strong>
          </div>
          <div class="card-body">
            <textarea name="attendeeEmails" class="form-control form-control-sm" rows="5"
                      placeholder="one@example.com&#10;two@example.com"
                      ><%= booking && booking.attendees ? booking.attendees.map(a => a.email).join('\n') : '' %></textarea>
            <div class="form-text"><%= t('bookings.attendeeEmailsHint') %></div>
          </div>
        </div>

        <!-- Catering -->
        <div class="card border-0 shadow-sm mb-4" id="cateringCard">
          <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
            <strong><i class="bi bi-cup-hot me-1"></i><%= t('bookings.catering') %></strong>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="addCateringRow">
              <i class="bi bi-plus"></i>
            </button>
          </div>
          <div class="card-body">
            <div id="cateringRows">
              <% if (booking && booking.catering && booking.catering.length > 0) { %>
                <% booking.catering.forEach(c => { %>
                  <div class="catering-row d-flex gap-2 mb-2">
                    <input type="text" name="catering_option" class="form-control form-control-sm"
                           value="<%= c.cateringOption %>" placeholder="<%= t('bookings.cateringOption') %>">
                    <input type="number" name="catering_qty" class="form-control form-control-sm"
                           value="<%= c.quantity %>" min="1" style="width:72px;">
                    <button type="button" class="btn btn-sm btn-outline-danger remove-catering">
                      <i class="bi bi-trash"></i>
                    </button>
                  </div>
                <% }) %>
              <% } else { %>
                <div class="catering-row d-flex gap-2 mb-2">
                  <input type="text" name="catering_option" class="form-control form-control-sm"
                         placeholder="<%= t('bookings.cateringOption') %>">
                  <input type="number" name="catering_qty" class="form-control form-control-sm"
                         value="1" min="1" style="width:72px;">
                  <button type="button" class="btn btn-sm btn-outline-danger remove-catering">
                    <i class="bi bi-trash"></i>
                  </button>
                </div>
              <% } %>
            </div>
            <div class="form-text"><%= t('bookings.cateringHint') %></div>
          </div>
        </div>

        <div class="d-grid gap-2">
          <button type="submit" class="btn btn-primary btn-lg">
            <i class="bi bi-check-lg me-1"></i>
            <%= booking ? t('bookings.saveChanges') : t('bookings.confirmBooking') %>
          </button>
          <a href="<%= booking ? '/bookings/' + booking.id : '/bookings' %>" class="btn btn-outline-secondary">
            <i class="bi bi-x me-1"></i><%= t('common.cancel') %>
          </a>
        </div>

      </div>
    </div>
  </form>
</main>

<script>
  function selectRoom(id) {
    document.getElementById('room_' + id).checked = true;
    document.querySelectorAll('.room-card').forEach(c => c.classList.remove('border-primary', 'bg-primary-subtle'));
    const card = document.querySelector(`.room-card:has(#room_${id})`);
    if (card) card.classList.add('border-primary');
  }

  // Add catering row
  document.getElementById('addCateringRow').addEventListener('click', () => {
    const row = document.createElement('div');
    row.className = 'catering-row d-flex gap-2 mb-2';
    row.innerHTML = `<input type="text" name="catering_option" class="form-control form-control-sm" placeholder="${document.querySelector('[data-i18n="catering_option"]')?.textContent || 'Option'}">` +
      `<input type="number" name="catering_qty" class="form-control form-control-sm" value="1" min="1" style="width:72px;">` +
      `<button type="button" class="btn btn-sm btn-outline-danger remove-catering"><i class="bi bi-trash"></i></button>`;
    document.getElementById('cateringRows').appendChild(row);
  });

  document.getElementById('cateringRows').addEventListener('click', (e) => {
    const btn = e.target.closest('.remove-catering');
    if (btn) btn.closest('.catering-row').remove();
  });

  // Availability check
  document.getElementById('checkAvailabilityBtn').addEventListener('click', async () => {
    const date = document.getElementById('date').value;
    const startTime = document.getElementById('startTime').value;
    const endTime = document.getElementById('endTime').value;
    const hint = document.getElementById('availabilityHint');

    if (!date || !startTime || !endTime) {
      hint.innerHTML = '<span class="text-danger">Please select date and time first.</span>';
      return;
    }
    if (startTime >= endTime) {
      hint.innerHTML = '<span class="text-danger">End time must be after start time.</span>';
      return;
    }

    hint.innerHTML = '<span class="text-muted"><i class="bi bi-hourglass-split me-1"></i>Checking availability…</span>';

    try {
      const resp = await fetch(`/api/rooms/available?date=${date}&startTime=${encodeURIComponent(startTime)}&endTime=${encodeURIComponent(endTime)}`);
      const available = await resp.json();
      const availableIds = new Set(available.map(r => r.id));

      document.querySelectorAll('.room-card').forEach(card => {
        const input = card.querySelector('input[name="roomId"]');
        const roomId = Number(input.value);
        if (availableIds.has(roomId)) {
          card.classList.remove('opacity-50');
          card.querySelector('label').querySelector('.avail-badge')?.remove();
          const badge = document.createElement('span');
          badge.className = 'avail-badge badge bg-success-subtle text-success ms-1';
          badge.textContent = 'Available';
          card.querySelector('label').appendChild(badge);
          input.disabled = false;
          card.style.cursor = 'pointer';
        } else {
          card.classList.add('opacity-50');
          card.querySelector('label').querySelector('.avail-badge')?.remove();
          const badge = document.createElement('span');
          badge.className = 'avail-badge badge bg-danger-subtle text-danger ms-1';
          badge.textContent = 'Unavailable';
          card.querySelector('label').appendChild(badge);
          input.checked = false;
          input.disabled = true;
          card.style.cursor = 'default';
        }
      });

      hint.innerHTML = `<span class="text-success"><i class="bi bi-check-circle me-1"></i>${available.length} room(s) available for selected time.</span>`;
    } catch (e) {
      hint.innerHTML = '<span class="text-danger">Could not check availability. Please try again.</span>';
    }
  });
</script>

<%- include('../partials/footer') %>
